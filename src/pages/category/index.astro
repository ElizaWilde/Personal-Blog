---
import Layout from '~/layouts/PageLayout.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { BLOG_BLOCKS } from '~/config/blog-blocks';

const posts = await fetchPosts();

const blocks = (BLOG_BLOCKS || []).map((block) => {
  const children = block.children.map((child) => ({
    ...child,
    count: posts.filter((post) => post.category?.title === child.title).length,
  }));
  return { ...block, children, count: children.reduce((total, child) => total + child.count, 0) };
});

const metadata = {
  title: 'Blocks',
  description: 'The core learning blocks used to organize the blog.',
};
---

<Layout metadata={metadata}>
  <main class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div class="max-w-3xl">
      <div class="text-xs font-medium uppercase tracking-[0.18em] opacity-60">Categories</div>
      <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Blog taxonomy</h1>
      <p class="mt-3 text-sm opacity-80 sm:text-base">Browse notes by the core knowledge block they belong to.</p>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {
        blocks.map((block) => (
          <section
            id={block.slug}
            class="scroll-mt-28 rounded-2xl border border-white/30 bg-white/40 p-6 shadow-sm backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/40"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="text-xs font-medium uppercase tracking-[0.18em] opacity-60">Root block</div>
                <h2 class="mt-2 text-2xl font-semibold">
                  <a class="hover:underline" href={getPermalink(block.slug, 'category')}>
                    {block.title}
                  </a>
                </h2>
                <p class="mt-2 text-sm opacity-75">{block.description}</p>
              </div>
              <div class="rounded-full border border-white/30 px-3 py-1 text-sm dark:border-white/10">
                {block.count} posts
              </div>
            </div>

            {block.children.length > 0 && (
              <div class="mt-5 grid gap-2 sm:grid-cols-2">
                {block.children.map((child) => (
                  <a
                    href={getPermalink(child.slug, 'category')}
                    class="rounded-xl border border-white/30 bg-white/30 p-3 transition hover:bg-white/60 dark:border-white/10 dark:bg-slate-900/30 dark:hover:bg-slate-900/60"
                  >
                    <div class="font-medium">{child.title}</div>
                    <div class="mt-1 text-xs opacity-60">{child.count} posts</div>
                  </a>
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>
  </main>
</Layout>
