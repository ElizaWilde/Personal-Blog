---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, fetchPosts } from '~/utils/blog';
import { CATEGORY_BASE, getPermalink } from '~/utils/permalinks';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import { BLOG_BLOCK_PAGES } from '~/config/blog-blocks';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await fetchPosts();

  return BLOG_BLOCK_PAGES.map((block) => ({
    params: { blog: CATEGORY_BASE || undefined, category: block.slug, page: undefined },
    props: {
      block,
      posts: posts.filter((post) => block.categoryTitles.includes(post.category?.title || '')),
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { block, posts } = Astro.props as Props;

const metadata = {
  title: block.title,
  description: block.description,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <div
      class="mb-10 rounded-2xl border border-white/30 bg-white/40 p-6 backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/40"
    >
      <div class="text-xs font-medium uppercase tracking-[0.18em] opacity-60">
        {block.parent ? `${block.parent.title} · Sub-block` : 'Root block'}
      </div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{block.title}</h1>
      <p class="mt-3 max-w-2xl text-base opacity-80">{block.description}</p>

      {
        block.children.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {block.children.map((child) => (
              <a
                class="rounded-full border border-white/30 bg-white/30 px-4 py-2 text-sm font-medium transition hover:bg-white/60 dark:border-white/10 dark:bg-slate-900/30 dark:hover:bg-slate-900/60"
                href={getPermalink(child.slug, 'category')}
              >
                {child.title}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div class="mb-6 flex items-baseline justify-between gap-4">
      <h2 class="text-2xl font-bold">Posts</h2>
      <span class="text-sm opacity-65">{posts.length} total</span>
    </div>

    {
      posts.length > 0 ? (
        <BlogList posts={posts} />
      ) : (
        <div class="rounded-2xl border border-white/30 bg-white/30 p-6 text-base opacity-75 backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/30">
          No posts in this block yet.
        </div>
      )
    }
  </section>
</Layout>
