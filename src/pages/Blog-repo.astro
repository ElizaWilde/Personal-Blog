---
import Layout from '~/layouts/PageLayout.astro';

const metadata = { title: 'Blog Repository' };

const sections = [
  { id: 'full-stack', title: 'Full-stack', href: '/category/full-stack' },
  { id: 'agent', title: 'Agent', href: '/category/agent' },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog Repository</h1>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        sections.map((section) => (
          <a
            id={section.id}
            href={section.href}
            class="scroll-mt-28 rounded-2xl border border-white/30 bg-white/40 p-6 text-lg font-semibold shadow-sm backdrop-blur-xl transition hover:-translate-y-0.5 hover:bg-white/60 hover:text-link dark:border-white/10 dark:bg-slate-900/40 dark:hover:bg-slate-900/60 dark:hover:text-white"
          >
            <span>{section.title}</span>
            <span class="ml-2" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
