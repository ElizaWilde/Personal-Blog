---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul>
  {
    posts.map((post) => (
      <li class={post.excerpt?.trim() ? 'mb-12 md:mb-20' : 'mb-6'}>
        <Item post={post} />
      </li>
    ))
  }
</ul>
