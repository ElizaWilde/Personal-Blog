---
import { getPermalink } from '~/utils/permalinks';
import { BLOG_BLOCKS } from '~/config/blog-blocks';
import { fetchPosts } from '~/utils/blog';

const posts = await fetchPosts();
const latest = posts.slice(0, 6);

const blocks = (BLOG_BLOCKS || []).map((block) => ({
  ...block,
  children: block.children.map((child) => ({
    ...child,
    count: posts.filter((post) => (post.category?.title || '').trim() === child.title).length,
  })),
}));
---

<section class="relative">
  <!-- Glass background blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute -top-32 -left-32 h-96 w-96 rounded-full blur-3xl opacity-30 bg-gradient-to-br from-white to-slate-300 dark:from-slate-700 dark:to-slate-900"
    >
    </div>
    <div
      class="absolute top-24 -right-40 h-[32rem] w-[32rem] rounded-full blur-3xl opacity-30 bg-gradient-to-br from-sky-200 to-indigo-200 dark:from-sky-900 dark:to-indigo-900"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <!-- Hero glass card -->
    <div
      class="rounded-3xl border border-white/30 bg-white/40 p-6 shadow-lg backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/40 sm:p-10"
    >
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold opacity-80">QingTaoRS Devlog</p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-5xl">
            Build notes, bugs, and progress —<br class="hidden sm:block" />
            in a glass-style blog.
          </h1>
          <p class="mt-4 max-w-2xl opacity-80">
            I write about project progress, debugging notes, and what I learned. Posts are grouped by categories for
            fast browsing.
          </p>
        </div>

        <div
          class="rounded-2xl border border-white/30 bg-white/30 p-4 backdrop-blur-md dark:border-white/10 dark:bg-slate-900/30"
        >
          <div class="text-sm opacity-80">Quick stats</div>
          <div class="mt-2 flex gap-6">
            <div>
              <div class="text-2xl font-bold">{posts.length}</div>
              <div class="text-xs opacity-70">posts</div>
            </div>
            <div>
              <div class="text-2xl font-bold">{blocks.length}</div>
              <div class="text-xs opacity-70">blocks</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Root blocks -->
      <div class="mt-8">
        <div class="text-lg font-semibold tracking-tight opacity-85 sm:text-xl">Blocks</div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          {
            blocks.length === 0 ? (
              <span class="text-sm opacity-70">No blocks configured.</span>
            ) : (
              blocks.map((block) => (
                <section
                  id={block.slug}
                  class="scroll-mt-28 rounded-2xl border border-white/30 bg-white/30 p-5 backdrop-blur-md dark:border-white/10 dark:bg-slate-900/30"
                >
                  <h2 class="text-xl font-bold">
                    <a class="hover:underline" href={getPermalink(block.slug, 'category')}>
                      {block.title}
                    </a>
                  </h2>
                  <p class="mt-2 text-sm opacity-75">{block.description}</p>
                  {block.children.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {block.children.map((child) => (
                        <a
                          class="inline-flex min-h-11 items-center rounded-full border border-white/30 bg-white/30 px-4 py-2 text-sm font-medium leading-none transition hover:bg-white/60 dark:border-white/10 dark:bg-slate-900/30 dark:hover:bg-slate-900/60"
                          href={getPermalink(child.slug, 'category')}
                        >
                          {child.title}
                          {child.count > 0 && <span class="ml-1.5 opacity-60">{child.count}</span>}
                        </a>
                      ))}
                    </div>
                  )}
                </section>
              ))
            )
          }
        </div>
      </div>
    </div>

    <!-- Latest posts -->
    <div class="mt-10">
      <div class="flex items-end justify-between">
        <h2 class="text-xl font-bold">Latest posts</h2>
        <a class="text-sm underline opacity-80 hover:opacity-100" href="/blog">View all</a>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          latest.map((p) => (
            <a
              class="group rounded-2xl border border-white/30 bg-white/40 p-5 shadow-sm backdrop-blur-xl transition hover:bg-white/60 dark:border-white/10 dark:bg-slate-900/40 dark:hover:bg-slate-900/60"
              href={getPermalink(p.permalink, 'post')}
            >
              <div class="text-xs opacity-70">
                {p.publishDate ? new Date(p.publishDate).toISOString().slice(0, 10) : ''}
                {p.category?.title ? <span> · {p.category.title}</span> : null}
              </div>
              <div class="mt-2 text-lg font-semibold group-hover:underline">{p.title}</div>
              {p.excerpt ? <div class="mt-2 text-sm opacity-80">{p.excerpt}</div> : null}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
